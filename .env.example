# =============================================================================
# Bastion Host / Jump Server — environment template
# =============================================================================
# Copy this file to `.env` (gitignored) and replace the placeholders. No value
# below is usable: the public key is deliberately not a valid key, and the
# source CIDR is a documentation range (RFC 5737).
#
# Paths are resolved relative to docker/docker-compose.yml, not this file.
# Create the host directories before the first start:
#   mkdir -p runtime/host_keys runtime/authorized_keys runtime/audit

# --- Administrative listener -------------------------------------------------
# Loopback is the safe default. A real bastion binds 0.0.0.0 only when the OCI
# security list/NSG restricts 2222/tcp to the operator's /32.
BASTION_SSH_BIND_ADDRESS=127.0.0.1
BASTION_SSH_PORT=2222

# --- Runtime material (never tracked) ---------------------------------------
BASTION_HOST_KEY_DIR=../runtime/host_keys
BASTION_AUTHORIZED_KEYS_DIR=../runtime/authorized_keys
BASTION_AUDIT_DIR=../runtime/audit

# --- Administrator access ----------------------------------------------------
# Copy the real public key to $BASTION_AUTHORIZED_KEYS_DIR/bastion and set
# mode 0600. The value here is a placeholder, not a key.
BASTION_ADMIN_PUBLIC_KEY_PATH=../runtime/authorized_keys/bastion
BASTION_ADMIN_PUBLIC_KEY=ssh-ed25519 PLACEHOLDER_PUBLIC_KEY admin@example.invalid

# --- Access policy example (validated by configs/whitelist.schema.json) ------
BASTION_ALLOWED_CIDR=203.0.113.10/32
BASTION_TARGET_HOST=10.0.0.10
BASTION_TARGET_PORT=22
BASTION_MAX_SESSION_MINUTES=60

# --- Runtime -----------------------------------------------------------------
TZ=UTC
