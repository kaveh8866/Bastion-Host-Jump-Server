{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudguard.local/schemas/bastion-whitelist-v1.json",
  "title": "CloudGuard Bastion access whitelist",
  "description": "Declarative allowlist for administrative identities and the private destinations they may reach through the jump host.",
  "type": "object",
  "required": ["version", "users"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "users": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "public_key", "source_cidrs", "targets"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
          },
          "public_key": {
            "type": "string",
            "minLength": 32,
            "description": "OpenSSH public key line; private keys never belong here."
          },
          "source_cidrs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])/([0-9]|[12][0-9]|3[0-2])$",
              "not": { "const": "0.0.0.0/0" },
              "description": "Specific management range; the IPv4 default route is rejected."
            }
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["host", "port"],
              "additionalProperties": false,
              "properties": {
                "host": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "description": {
                  "type": "string",
                  "maxLength": 160
                }
              }
            }
          },
          "max_session_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 480,
            "default": 60
          }
        }
      }
    }
  }
}
